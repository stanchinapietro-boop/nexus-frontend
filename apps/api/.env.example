# Copia questo file in apps/api/.env e compila i valori. Il file .env non va mai condiviso.
# Opzione semplice: token personale (al posto di Client ID e Secret)
TICKTICK_TOKEN=

TICKTICK_CLIENT_ID=
TICKTICK_CLIENT_SECRET=
TICKTICK_REDIRECT_URI=http://localhost:8000/api/ticktick/callback
TICKTICK_TIMEZONE=Europe/Rome
FRONTEND_URL=http://localhost:5173
